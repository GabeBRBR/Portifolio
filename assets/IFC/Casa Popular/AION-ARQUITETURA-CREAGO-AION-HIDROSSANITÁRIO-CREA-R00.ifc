#10389=IFCPROPERTYSINGLEVALUE('DarivaBIM: Dimensionamento',$,IFCTEXT('ABNT. ASSOCIA\X\C7\X\C3O BRASILEIRA DE NORMAS T\X\C9CNICAS. NBR 8160: Sistemas prediais de esgoto sanit\X\E1rio - Projeto e execu\X\E7\X\E3o. Rio de Janeiro, 1999. 74 p.'),$);
#10390=IFCPROPERTYSINGLEVALUE('DarivaBIM: Execu\X\E7\X\E3o',$,IFCTEXT('https://www.youtube.com/watch?v=xvO1P7Bh85I'),$);
